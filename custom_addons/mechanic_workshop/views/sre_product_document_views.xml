<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Product Document Form -->
    <record id="sre_product_document_view_form" model="ir.ui.view">
        <field name="name">product.document.form.sre.inherit</field>
        <field name="model">product.document</field>
        <field name="inherit_id" ref="product.product_document_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group name="sre_governance" string="SRE Document Governance &amp; Technical Specs">
                    <group>
                        <field name="document_type"/>
                        <field name="governance_type" widget="radio"/>
                    </group>
                    <group>
                        <field name="cad_format"/>
                        <field name="download_count" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Inherit Product Document List -->
    <record id="sre_product_document_view_list" model="ir.ui.view">
        <field name="name">product.document.list.sre.inherit</field>
        <field name="model">product.document</field>
        <field name="inherit_id" ref="product.product_document_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="document_type" widget="badge"/>
                <field name="governance_type" widget="badge"
                       decoration-success="governance_type == 'public'"
                       decoration-warning="governance_type == 'gated'"
                       decoration-muted="governance_type == 'internal'"/>
                <field name="cad_format"/>
                <field name="download_count" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Product Document Search -->
    <record id="sre_product_document_view_search" model="ir.ui.view">
        <field name="name">product.document.search.sre.inherit</field>
        <field name="model">product.document</field>
        <field name="inherit_id" ref="product.product_document_search"/>
        <field name="arch" type="xml">
            <search position="inside">
                <separator/>
                <filter name="filter_public" string="Public Documents" domain="[('governance_type', '=', 'public')]"/>
                <filter name="filter_gated" string="Gated (B2B Lead Required)" domain="[('governance_type', '=', 'gated')]"/>
                <filter name="filter_internal" string="Internal Only" domain="[('governance_type', '=', 'internal')]"/>
                <separator/>
                <filter name="filter_cad" string="CAD &amp; Drawings" domain="[('document_type', '=', 'cad_drawing')]"/>
                <filter name="filter_datasheet" string="Datasheets" domain="[('document_type', '=', 'datasheet')]"/>
                <filter name="filter_manual" string="Manuals" domain="[('document_type', '=', 'manual')]"/>
                <filter name="filter_certificate" string="Certificates" domain="[('document_type', '=', 'certificate')]"/>
            </search>
        </field>
    </record>

    <!-- Action for Central Technical Documents -->
    <record id="action_sre_product_documents" model="ir.actions.act_window">
        <field name="name">Technical Documents &amp; CAD Library</field>
        <field name="res_model">product.document</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_all': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Upload Technical Documents, Datasheets and CAD Drawings
            </p>
            <p>
                Manage rights-approved public, gated B2B, and internal engineering documents for catalog products.
            </p>
        </field>
    </record>

    <!-- Menu Item under SRE Catalog -->
    <menuitem id="menu_sre_product_documents"
              name="Technical Documents &amp; CAD"
              parent="mechanic_workshop.sre_pillar_menu"
              action="action_sre_product_documents"
              sequence="40"/>
</odoo>
