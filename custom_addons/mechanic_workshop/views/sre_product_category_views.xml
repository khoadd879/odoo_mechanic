<odoo>
    <record id="sre_category_list" model="ir.ui.view">
        <field name="name">sre.product.category.list</field>
        <field name="model">sre.product.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="pillar_id"/>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="slug"/>
                <field name="family_count"/>
                <field name="product_count"/>
                <field name="is_published"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="sre_category_form" model="ir.ui.view">
        <field name="name">sre.product.category.form</field>
        <field name="model">sre.product.category</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="is_published" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="slug"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="pillar_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Product Families">
                            <field name="family_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="slug"/>
                                    <field name="attribute_profile_id"/>
                                    <field name="product_count"/>
                                    <field name="is_published"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sre_category_action" model="ir.actions.act_window">
        <field name="name">Product Categories</field>
        <field name="res_model">sre.product.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="sre_category_menu_items" name="Product Categories"
              parent="sre_pillar_menu" action="sre_category_action"
              sequence="15"/>
</odoo>
