<odoo>
    <record id="rfq_sequence" model="ir.sequence"><field name="name">Customer RFQ</field><field name="code">sre.rfq</field><field name="prefix">RFQ-</field><field name="padding">6</field></record>
    <record id="rfq_company_rule" model="ir.rule"><field name="name">RFQ company</field><field name="model_id" ref="model_sre_rfq"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
    <record id="rfq_line_company_rule" model="ir.rule"><field name="name">RFQ line company</field><field name="model_id" ref="model_sre_rfq_line"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
    <record id="rfq_list" model="ir.ui.view"><field name="name">sre.rfq.list</field><field name="model">sre.rfq</field><field name="arch" type="xml"><list><field name="name"/><field name="company_name"/><field name="contact_name"/><field name="email"/><field name="required_delivery_date"/><field name="state"/></list></field></record>
    <record id="rfq_form" model="ir.ui.view"><field name="name">sre.rfq.form</field><field name="model">sre.rfq</field><field name="arch" type="xml">
        <form><header><button name="action_create_quotation" type="object" string="Create / Open Quotation" class="btn-primary"/><field name="state" widget="statusbar"/></header><sheet>
        <h1><field name="name"/></h1>
        <group><group><field name="company_name"/><field name="contact_name"/><field name="email"/><field name="phone"/><field name="partner_id" readonly="order_id"/></group><group><field name="project_name"/><field name="project_location"/><field name="required_delivery_date"/><field name="company_id" groups="base.group_multi_company"/><field name="website_id"/><field name="lead_id"/><field name="order_id"/></group></group>
        <p>Select a verified customer before creating a quotation. Submitted email does not verify account ownership.</p>
        <field name="line_ids" readonly="order_id"><list editable="bottom"><field name="product_id"/><field name="quantity"/><field name="uom_id"/></list></field><field name="notes"/>
        </sheet></form></field></record>
    <record id="rfq_action" model="ir.actions.act_window"><field name="name">Customer RFQs</field><field name="res_model">sre.rfq</field><field name="view_mode">list,form</field></record>
    <menuitem id="rfq_menu" name="Customer RFQs" parent="sale.sale_menu_root" action="rfq_action" sequence="25" groups="sales_team.group_sale_salesman"/>
    <record id="rfq_lead_form" model="ir.ui.view"><field name="name">crm.lead.rfq</field><field name="model">crm.lead</field><field name="inherit_id" ref="crm.crm_lead_view_form"/><field name="arch" type="xml"><field name="partner_id" position="after"><field name="sre_rfq_id" invisible="not sre_rfq_id"/></field></field></record>
</odoo>
