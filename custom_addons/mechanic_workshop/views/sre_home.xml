<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sre_home_page" name="SRE Homepage">
        <t t-call="website.layout">
            <div class="sre-home">
                <section class="sre-home__hero"><div class="container">
                    <h1>Industrial HVAC, Boiler &amp; Process Equipment</h1>
                    <p>Components. Spare Parts. Controls. Instrumentation.</p>
                    <div class="sre-home__search"><form action="/sre/catalog" method="get" role="search">
                        <input type="search" name="search" placeholder="Search by Part Number, Model, Brand or Product" aria-label="Search catalog"/>
                        <button type="submit">Search</button>
                    </form></div>
                </div></section>
                <section class="sre-home__pillars"><div class="container"><h2>Quick Access</h2><div class="sre-home__pillars-grid">
                    <a t-foreach="pillars" t-as="pillar" t-att-href="'/sre/catalog/pillar/%s' % pillar.slug" t-esc="pillar.short_label or pillar.name"/>
                </div></div></section>
                <section class="sre-home__taxonomy"><div class="container"><h2>Shop by Industry</h2>
                    <t t-if="industries"><div class="sre-home__taxonomy-grid"><a t-foreach="industries" t-as="industry" t-att-href="'/sre/catalog?industry=%s' % industry.slug"><span class="name" t-esc="industry.name"/><span class="count"><t t-esc="industry.product_count"/> products</span></a></div></t>
                    <div t-if="not industries" class="sre-home__taxonomy--empty">No industries seeded yet.</div>
                </div></section>
                <section class="sre-home__taxonomy"><div class="container"><h2>Shop by Application</h2>
                    <t t-if="applications"><div class="sre-home__taxonomy-grid sre-home__taxonomy-grid--three"><a t-foreach="applications" t-as="application" t-att-href="'/sre/catalog?application=%s' % application.slug"><span class="name" t-esc="application.name"/><span class="count"><t t-esc="application.product_count"/> products</span></a></div></t>
                    <div t-if="not applications" class="sre-home__taxonomy--empty">No applications seeded yet.</div>
                </div></section>
                <t t-if="featured_products"><section class="sre-home__featured"><div class="container"><h2>Featured Categories</h2><div class="sre-catalog">
                    <a t-foreach="featured_products" t-as="product" t-att-href="product.website_url" class="sre-tile"><div class="sre-tile__primary"><div class="sre-tile__head"><span t-if="product.default_code" class="sre-tile__sku sre-mono" t-esc="product.default_code"/><span t-if="product.product_brand_id" class="sre-tile__brand sre-mono" t-esc="product.product_brand_id.name"/></div><h3 class="sre-tile__name" t-esc="product.name"/><div class="sre-tile__mpn sre-mono"><t t-if="product.manufacturer_pref"><span class="sre-tile__mpn-label">MPN</span><span t-esc="product.manufacturer_pref"/></t></div></div><dl class="sre-tile__specs"><t t-if="product.family_id"><dt>Family</dt><dd t-esc="product.family_id.name"/></t><t t-if="product.manufacturer_public_name"><dt>Mfr</dt><dd t-esc="product.manufacturer_public_name"/></t></dl><div class="sre-tile__meta"><div class="sre-tile__meta-row"><span class="dot"/><span>Request quote</span></div><div class="sre-tile__meta-row sre-mono">5-7 day lead</div></div><div class="sre-tile__cta">View details</div></a>
                </div></div></section></t>
                <section class="sre-home__resources"><div class="container"><h2>Technical Resources</h2><div class="sre-home__resources-grid"><a href="/sre/catalog"><span class="name">Browse Catalog</span><span class="hint">Search by SKU, MPN, Brand or keyword across 8 pillars.</span></a><a href="/rfq"><span class="name">Submit an RFQ</span><span class="hint">Engineering team responds within one business day.</span></a></div></div></section>
                <section class="sre-home__cta"><div class="container"><div class="sre-lead"><div><h2 class="sre-lead__title">Need help specifying the right part?</h2><p class="sre-lead__body">Our engineering team can review your application — operating pressure, fluid, temperature, connection standard — and recommend a verified part number. Submit an RFQ and we will respond within one business day.</p></div><a class="sre-lead__cta" href="/rfq">Request a quote</a></div></div></section>
                <footer class="sre-home__footer"><div class="container">SRE Commercial © 2026 — Industrial Product Distribution Platform</div></footer>
            </div>
        </t>
    </template>
</odoo>
