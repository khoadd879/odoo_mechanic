<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- =================================================================
     SRE product tile — McMaster-Carr style 4-column table-row (v2).
     Identity / Specs / Meta / Action columns. Dense info, monospace
     identifiers, no card, no marketing.
     ================================================================= -->
<template id="sre_products_item_inherit"
          inherit_id="website_sale.products_item"
          name="SRE Catalog Tile"
          active="True">

    <xpath expr="//form" position="replace">
        <a t-att-href="product_href or product.website_url"
           class="sre-tile"
           itemscope="itemscope"
           itemtype="http://schema.org/Product">

            <meta itemprop="name" t-att-content="product.name"/>
            <meta itemprop="sku" t-att-content="product.default_code or ''"/>

            <div class="sre-tile__primary">
                <div class="sre-tile__head">
                    <t t-if="product.default_code">
                        <span class="sre-tile__sku sre-mono"
                              t-esc="product.default_code"/>
                    </t>
                    <t t-if="product.product_brand_id">
                        <span class="sre-tile__brand sre-mono"
                              t-esc="product.product_brand_id.name"/>
                    </t>
                </div>
                <h3 class="sre-tile__name">
                    <span t-esc="product.name"/>
                </h3>
                <div class="sre-tile__mpn sre-mono">
                    <t t-if="product.manufacturer_pref">
                        <span class="sre-tile__mpn-label">MPN</span>
                        <span t-esc="product.manufacturer_pref"/>
                    </t>
                </div>
            </div>

            <dl class="sre-tile__specs">
                <t t-if="product.family_id">
                    <dt>Family</dt>
                    <dd t-esc="product.family_id.name"/>
                </t>
                <t t-if="product.manufacturer_public_name">
                    <dt>Mfr</dt>
                    <dd t-esc="product.manufacturer_public_name"/>
                </t>
                <t t-if="product.sre_public_oem_part_numbers">
                    <dt>OEM PN</dt>
                    <dd t-esc="product.sre_public_oem_part_numbers"/>
                </t>
            </dl>

            <div class="sre-tile__meta">
                <div class="sre-tile__meta-row">
                    <span class="dot"/>
                    <span>Availability on request</span>
                </div>
                <t t-if="product.public_price_approved and product.list_price">
                    <div class="sre-tile__meta-row sre-mono" style="color:var(--sre-blue-600, #1565c0);font-weight:600;">
                        <span t-field="product.list_price" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                    </div>
                </t>
                <t t-else="">
                    <div class="sre-tile__meta-row sre-mono" style="color:var(--sre-fg-faint);">No public price</div>
                </t>
            </div>

            <div class="sre-tile__cta">
                View &amp; RFQ
            </div>
        </a>
    </xpath>

</template>
</odoo>
