<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sre_product_card" name="SRE technical product card">
        <article t-att-class="'sre-product-card sre-product-card--%s' % (card_layout or 'list')"
                 itemscope="itemscope"
                 itemtype="https://schema.org/Product">
            <a t-att-href="product.website_url" class="sre-product-card__media" tabindex="-1">
                <img t-if="product.image_128"
                     t-att-src="'/web/image/product.template/%s/image_256' % product.id"
                     t-att-alt="product.name"
                     loading="lazy"/>
                <span t-else="" class="sre-product-card__placeholder" aria-hidden="true">
                    <span class="fa fa-cogs"/>
                </span>
            </a>
            <div class="sre-product-card__identity">
                <div class="sre-product-card__eyebrow">
                    <span t-if="product.default_code" class="sre-mono" itemprop="sku" t-esc="product.default_code"/>
                    <span t-if="product.product_brand_id" t-esc="product.product_brand_id.name"/>
                </div>
                <h2>
                    <a t-att-href="product.website_url" itemprop="url">
                        <span itemprop="name" t-esc="product.name"/>
                    </a>
                </h2>
                <p t-if="product.manufacturer_pref" class="sre-product-card__mpn">
                    <span>MPN</span>
                    <strong t-esc="product.manufacturer_pref"/>
                </p>
            </div>
            <dl class="sre-product-card__specs">
                <t t-if="product.family_id">
                    <dt>Family</dt><dd t-esc="product.family_id.name"/>
                </t>
                <t t-if="product.manufacturer_public_name">
                    <dt>Manufacturer</dt><dd t-esc="product.manufacturer_public_name"/>
                </t>
                <t t-if="product.sre_public_oem_part_numbers">
                    <dt>OEM PN</dt><dd t-esc="product.sre_public_oem_part_numbers"/>
                </t>
                <t t-if="len(product.product_variant_ids) &gt; 1">
                    <dt>Options</dt><dd><t t-esc="len(product.product_variant_ids)"/> variants</dd>
                </t>
            </dl>
            <div class="sre-product-card__commercial">
                <span class="sre-status"><i aria-hidden="true"/>Availability on request</span>
                <small>No public price</small>
            </div>
            <div class="sre-product-card__actions">
                <a t-att-href="product.website_url" class="sre-link-arrow">Technical details</a>
                <a t-att-href="product.website_url + '#sre-rfq-panel'" class="sre-button sre-button--compact">Configure RFQ</a>
            </div>
        </article>
    </template>

    <template id="sre_catalog_page" name="SRE technical catalog">
        <t t-call="website.layout">
            <t t-set="additional_title">
                <t t-if="family" t-esc="family.name"/>
                <t t-elif="pillar" t-esc="pillar.name"/>
                <t t-elif="search">Search results</t>
                <t t-else="">Technical product catalog</t>
            </t>
            <div id="wrap" class="sre-catalog-page">
                <section class="sre-catalog-hero">
                    <div class="container">
                        <nav class="sre-breadcrumb" aria-label="Breadcrumb">
                            <a href="/">Home</a><span>/</span>
                            <a href="/sre/catalog">Catalog</a>
                            <t t-if="pillar"><span>/</span><span t-esc="pillar.short_label or pillar.name"/></t>
                            <t t-if="family"><span>/</span><span t-esc="family.name"/></t>
                        </nav>
                        <div class="sre-catalog-hero__row">
                            <div>
                                <span class="sre-kicker">SRE technical distribution</span>
                                <h1>
                                    <t t-if="family" t-esc="family.name"/>
                                    <t t-elif="pillar" t-esc="pillar.name"/>
                                    <t t-elif="industry" t-esc="industry.name"/>
                                    <t t-elif="application" t-esc="application.name"/>
                                    <t t-elif="search">Search results</t>
                                    <t t-else="">Technical product catalog</t>
                                </h1>
                                <p>
                                    Search verified identity fields and compare technical product data.
                                    Pricing, availability and lead time are confirmed through RFQ.
                                </p>
                            </div>
                            <div class="sre-catalog-hero__count">
                                <strong t-esc="products_count"/>
                                <span>matching products</span>
                            </div>
                        </div>
                        <div class="sre-catalog-hero__search">
                            <t t-call="mechanic_workshop.sre_search_form">
                                <t t-set="search_action" t-value="base_path"/>
                                <t t-set="search_value" t-value="search"/>
                            </t>
                            <p>Search priority: exact SKU → MPN → OEM part number → brand → keyword.</p>
                        </div>
                    </div>
                </section>

                <div class="container sre-catalog-shell">
                    <aside class="sre-catalog-filters" aria-label="Catalog filters">
                        <div class="sre-catalog-filters__head">
                            <div><span>Refine results</span><strong t-esc="products_count"/></div>
                            <a t-att-href="query_url(brand=None, attr=None, page=None)">Clear</a>
                        </div>

                        <section t-if="pillar and families" class="sre-filter-group">
                            <h2>Product family</h2>
                            <a t-att-href="'/sre/catalog/pillar/%s' % pillar.slug"
                               t-att-class="'sre-filter-link ' + ('is-active' if not family else '')">All <t t-esc="pillar.short_label or pillar.name"/></a>
                            <a t-foreach="families"
                               t-as="family_option"
                               t-att-href="'/sre/catalog/family/%s' % family_option.slug"
                               t-att-class="'sre-filter-link ' + ('is-active' if family and family.id == family_option.id else '')">
                                <span t-esc="family_option.name"/>
                                <small t-esc="family_option.product_count"/>
                            </a>
                        </section>

                        <form t-att-action="base_path" method="get" class="sre-filter-form">
                            <input t-if="search" type="hidden" name="search" t-att-value="search"/>
                            <input type="hidden" name="layout_mode" t-att-value="layout_mode"/>
                            <input type="hidden" name="order" t-att-value="sort_key"/>
                            <input type="hidden" name="per_page" t-att-value="per_page"/>
                            <input t-if="industry" type="hidden" name="industry" t-att-value="industry.slug"/>
                            <input t-if="application" type="hidden" name="application" t-att-value="application.slug"/>

                            <section t-if="brands" class="sre-filter-group">
                                <label for="sre-brand-filter">Brand</label>
                                <select id="sre-brand-filter" name="brand">
                                    <option value="">All brands</option>
                                    <option t-foreach="brands"
                                            t-as="brand_option"
                                            t-att-value="brand_option.id"
                                            t-att-selected="brand and brand.id == brand_option.id"
                                            t-esc="brand_option.name"/>
                                </select>
                            </section>

                            <section t-foreach="filter_lines" t-as="filter_line" class="sre-filter-group">
                                <h2 t-esc="filter_line['attribute'].name"/>
                                <label t-foreach="filter_line['values']" t-as="filter_value" class="sre-filter-check">
                                    <input type="checkbox"
                                           name="attr"
                                           t-att-value="'%s-%s' % (filter_line['attribute'].id, filter_value.id)"
                                           t-att-checked="'%s-%s' % (filter_line['attribute'].id, filter_value.id) in selected_attribute_keys"/>
                                    <span t-esc="filter_value.name"/>
                                </label>
                            </section>
                            <button type="submit" class="sre-button sre-button--full">Apply filters</button>
                        </form>

                        <div class="sre-catalog-filters__help">
                            <span class="fa fa-wrench" aria-hidden="true"/>
                            <div><strong>Not sure which specification?</strong><a href="/rfq">Ask engineering</a></div>
                        </div>
                    </aside>

                    <main class="sre-catalog-results">
                        <div t-if="search or industry or application or brand or selected_attribute_keys" class="sre-active-filters">
                            <span>Active:</span>
                            <a t-if="search" t-att-href="query_url(search=None, page=None)">Search: “<t t-esc="search"/>” ×</a>
                            <a t-if="industry" t-att-href="query_url(industry=None, page=None)">Industry: <t t-esc="industry.name"/> ×</a>
                            <a t-if="application" t-att-href="query_url(application=None, page=None)">Application: <t t-esc="application.name"/> ×</a>
                            <a t-if="brand" t-att-href="query_url(brand=None, page=None)">Brand: <t t-esc="brand.name"/> ×</a>
                        </div>

                        <div class="sre-catalog-toolbar">
                            <p>Showing <strong><t t-esc="page_start"/>–<t t-esc="page_end"/></strong> of <strong t-esc="products_count"/></p>
                            <div class="sre-catalog-toolbar__controls">
                                <label>Sort
                                    <select onchange="window.location.href=this.value">
                                        <option t-att-value="query_url(order='relevance', page=None)" t-att-selected="sort_key == 'relevance'">Relevance</option>
                                        <option t-att-value="query_url(order='name_asc', page=None)" t-att-selected="sort_key == 'name_asc'">Name A–Z</option>
                                        <option t-att-value="query_url(order='name_desc', page=None)" t-att-selected="sort_key == 'name_desc'">Name Z–A</option>
                                    </select>
                                </label>
                                <div class="sre-view-switch" role="group" aria-label="View mode">
                                    <a t-att-href="query_url(layout_mode='grid', page=None)" t-att-class="'fa fa-th-large ' + ('is-active' if layout_mode == 'grid' else '')" aria-label="Grid view"/>
                                    <a t-att-href="query_url(layout_mode='list', page=None)" t-att-class="'fa fa-list ' + ('is-active' if layout_mode == 'list' else '')" aria-label="List view"/>
                                    <a t-att-href="query_url(layout_mode='table', page=None)" t-att-class="'fa fa-table ' + ('is-active' if layout_mode == 'table' else '')" aria-label="Technical table view"/>
                                </div>
                            </div>
                        </div>

                        <t t-if="products">
                            <div t-if="layout_mode != 'table'" t-att-class="'sre-product-results sre-product-results--%s' % layout_mode">
                                <t t-foreach="products" t-as="product">
                                    <t t-call="mechanic_workshop.sre_product_card">
                                        <t t-set="card_layout" t-value="layout_mode"/>
                                    </t>
                                </t>
                            </div>
                            <div t-else="" class="sre-table-wrap">
                                <table class="sre-products-table">
                                    <thead><tr><th>Product</th><th>Brand</th><th>MPN</th><th>OEM PN</th><th>Availability</th><th/></tr></thead>
                                    <tbody>
                                        <tr t-foreach="products" t-as="product">
                                            <td><a t-att-href="product.website_url" t-esc="product.name"/><code t-if="product.default_code" t-esc="product.default_code"/></td>
                                            <td t-esc="product.product_brand_id.name or '—'"/>
                                            <td class="sre-mono" t-esc="product.manufacturer_pref or '—'"/>
                                            <td class="sre-mono" t-esc="product.sre_public_oem_part_numbers or '—'"/>
                                            <td><span class="sre-status"><i/>On request</span></td>
                                            <td><a t-att-href="product.website_url" class="sre-link-arrow">Details</a></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </t>
                        <div t-else="" class="sre-empty-state">
                            <span class="fa fa-search" aria-hidden="true"/>
                            <h2>No matching product found</h2>
                            <p>Check the part number, remove a filter, or send the identifier to our engineering team.</p>
                            <div><a t-att-href="base_path" class="sre-button sre-button--secondary">Clear search</a><a href="/rfq" class="sre-button">Ask engineering</a></div>
                        </div>

                        <nav t-if="total_pages &gt; 1" class="sre-pagination" aria-label="Catalog pages">
                            <a t-if="current_page &gt; 1" t-att-href="query_url(page=current_page - 1)" aria-label="Previous page">←</a>
                            <a t-foreach="pager_pages" t-as="page_number"
                               t-att-href="query_url(page=page_number)"
                               t-att-class="'is-active' if page_number == current_page else ''"
                               t-esc="page_number"/>
                            <a t-if="current_page &lt; total_pages" t-att-href="query_url(page=current_page + 1)" aria-label="Next page">→</a>
                            <label>Per page
                                <select onchange="window.location.href=this.value">
                                    <option t-foreach="page_sizes"
                                            t-as="page_size"
                                            t-att-value="query_url(per_page=page_size, page=None)"
                                            t-att-selected="page_size == per_page"
                                            t-esc="page_size"/>
                                </select>
                            </label>
                        </nav>

                        <section class="sre-engineering-cta">
                            <div><span class="sre-kicker">Application support</span><h2>Need help specifying the right part?</h2><p>Send operating pressure, medium, temperature and connection standard. We will review the application before quoting.</p></div>
                            <a href="/rfq" class="sre-button sre-button--light">Start an RFQ</a>
                        </section>
                    </main>
                </div>
            </div>
        </t>
    </template>
</odoo>
