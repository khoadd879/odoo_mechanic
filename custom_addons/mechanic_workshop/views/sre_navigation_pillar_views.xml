<odoo>
    <record id="sre_pillar_list" model="ir.ui.view">
        <field name="name">sre.navigation.pillar.list</field>
        <field name="model">sre.navigation.pillar</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="slug"/>
                <field name="family_count"/>
                <field name="product_count"/>
                <field name="is_published"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="sre_pillar_form" model="ir.ui.view">
        <field name="name">sre.navigation.pillar.form</field>
        <field name="model">sre.navigation.pillar</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="is_published" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="slug"/>
                            <field name="sequence"/>
                            <field name="short_label"/>
                        </group>
                        <group>
                            <field name="icon"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Families">
                            <field name="family_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="slug"/>
                                    <field name="attribute_profile_id"/>
                                    <field name="is_published"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="sre_pillar_action" model="ir.actions.act_window">
        <field name="name">Navigation Pillars</field>
        <field name="res_model">sre.navigation.pillar</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="sre_pillar_menu" name="SRE Catalog"
              parent="sale.sale_menu_root" sequence="22"
              groups="sales_team.group_sale_salesman"/>
    <menuitem id="sre_pillar_menu_items" name="Navigation Pillars"
              parent="sre_pillar_menu" action="sre_pillar_action"
              sequence="10"/>
</odoo>
