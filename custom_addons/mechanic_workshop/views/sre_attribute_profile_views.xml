<odoo>
    <record id="sre_attr_profile_list" model="ir.ui.view">
        <field name="name">sre.attribute.profile.list</field>
        <field name="model">sre.attribute.profile</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="family_count"/>
            </list>
        </field>
    </record>
    <record id="sre_attr_profile_form" model="ir.ui.view">
        <field name="name">sre.attribute.profile.form</field>
        <field name="model">sre.attribute.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <field name="note" placeholder="Internal note"/>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="attribute_id"/>
                            <field name="is_filter_shown"/>
                            <field name="value_ids" widget="many2many_tags"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="sre_attr_profile_action" model="ir.actions.act_window">
        <field name="name">Attribute Profiles</field>
        <field name="res_model">sre.attribute.profile</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="sre_attr_profile_menu_items" name="Attribute Profiles"
              parent="sre_pillar_menu" action="sre_attr_profile_action"
              sequence="30"/>
</odoo>
