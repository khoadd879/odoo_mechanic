<odoo>
    <record id="sre_family_list" model="ir.ui.view">
        <field name="name">sre.product.family.list</field>
        <field name="model">sre.product.family</field>
        <field name="arch" type="xml">
            <list>
                <field name="pillar_id"/>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="slug"/>
                <field name="attribute_profile_id"/>
                <field name="product_count"/>
                <field name="is_published"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="sre_family_form" model="ir.ui.view">
        <field name="name">sre.product.family.form</field>
        <field name="model">sre.product.family</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="is_published" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="slug"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="pillar_id"/>
                            <field name="attribute_profile_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="sre_family_action" model="ir.actions.act_window">
        <field name="name">Product Families</field>
        <field name="res_model">sre.product.family</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="sre_family_menu_items" name="Product Families"
              parent="sre_pillar_menu" action="sre_family_action"
              sequence="20"/>
</odoo>
