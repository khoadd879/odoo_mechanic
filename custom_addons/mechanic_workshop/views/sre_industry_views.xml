<odoo>
    <record id="sre_industry_list" model="ir.ui.view">
        <field name="name">sre.industry.list</field>
        <field name="model">sre.industry</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="slug"/>
                <field name="product_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="sre_industry_form" model="ir.ui.view">
        <field name="name">sre.industry.form</field>
        <field name="model">sre.industry</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="slug"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="sre_industry_action" model="ir.actions.act_window">
        <field name="name">Industries</field>
        <field name="res_model">sre.industry</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="sre_industry_menu_items" name="Industries"
              parent="sre_pillar_menu" action="sre_industry_action"
              sequence="40"/>

    <record id="sre_application_list" model="ir.ui.view">
        <field name="name">sre.application.list</field>
        <field name="model">sre.application</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="slug"/>
                <field name="product_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="sre_application_form" model="ir.ui.view">
        <field name="name">sre.application.form</field>
        <field name="model">sre.application</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="slug"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="sre_application_action" model="ir.actions.act_window">
        <field name="name">Applications</field>
        <field name="res_model">sre.application</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="sre_application_menu_items" name="Applications"
              parent="sre_pillar_menu" action="sre_application_action"
              sequence="50"/>
</odoo>
