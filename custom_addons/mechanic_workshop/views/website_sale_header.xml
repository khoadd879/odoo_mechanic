<odoo>
    <!-- =================================================================
         SRE public top navigation — 8 business pillars (brief §04).

         The 8 pillars are data-driven: the template iterates over
         ``request.website.sre_visible_pillars`` so we do not hard-code
         the names (brief §22 #7). Links point to ``/shop/pillar/<slug>``
         so the new route in ``controllers/shop.py`` picks the slug up
         as a path parameter. The McMaster-style industrial band is
         styled by ``static/src/scss/sre_topnav.scss``.
         ================================================================= -->
    <template id="sre_pillars_nav"
              inherit_id="website_sale.template_header_default"
              name="SRE 8-Pillar Top Nav"
              active="True">
        <xpath expr="//header" position="inside">
            <nav class="sre-pillars-nav"
                 aria-label="Business pillars">
                <div class="container">
                    <ul class="sre-pillars-nav__list">
                        <li t-foreach="request.website.sre_visible_pillars"
                            t-as="pillar"
                            t-attf-class="sre-pillars-nav__item #{pillar.slug == request.httprequest.path.split('/')[-1] and 'active' or ''}">
                            <a t-att-href="'/sre/catalog/pillar/%s' % pillar.slug"
                               class="sre-pillars-nav__link"
                               t-esc="pillar.short_label or pillar.name"/>
                        </li>
                    </ul>
                </div>
            </nav>
        </xpath>
    </template>

    <template id="sre_pillars_nav_mobile"
              inherit_id="website.template_header_mobile"
              name="SRE 8-Pillar Mobile Drawer"
              active="True">
        <xpath expr="//div[@id='top_menu_collapse_mobile']//div[hasclass('offcanvas-body')]"
               position="inside">
            <div class="sre-pillars-nav__mobile">
                <h2>Browse by category</h2>
                <ul class="nav flex-column">
                    <li t-foreach="request.website.sre_visible_pillars"
                        t-as="pillar"
                        class="nav-item">
                        <a t-att-href="'/sre/catalog/pillar/%s' % pillar.slug"
                           class="nav-link"
                           t-esc="pillar.short_label or pillar.name"/>
                    </li>
                </ul>
            </div>
        </xpath>
    </template>
</odoo>
