<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="rfq_unknown_part_page" name="SRE Unknown Part Identification RFQ">
        <t t-call="website.layout">
            <div id="wrap" class="sre-unknown-part-page py-5">
                <div class="container">
                    <!-- Breadcrumb -->
                    <nav class="sre-breadcrumb mb-3" aria-label="Breadcrumb">
                        <a href="/">Home</a><span>/</span>
                        <a href="/rfq">RFQ</a><span>/</span>
                        <span class="active">Unknown Part Identification</span>
                    </nav>

                    <div class="row justify-content-center">
                        <div class="col-lg-9">
                            <!-- Hero Card -->
                            <div class="card border-0 shadow-sm mb-4 bg-dark text-white p-4 rounded-3">
                                <div class="d-flex align-items-center mb-2">
                                    <span class="badge bg-warning text-dark me-2 text-uppercase fw-bold">Engineering Assistance</span>
                                    <span class="text-white-50 small">SRE Direct Fit Service</span>
                                </div>
                                <h1 class="h3 fw-bold mb-2">Identify Replacement Part from Nameplate &amp; Specs</h1>
                                <p class="text-white-50 mb-0">
                                    When part numbers are corroded, painted over, or missing, SRE engineers will cross-reference your equipment model, operating conditions, and stamped nameplate data to specify a 100% verified replacement.
                                </p>
                            </div>

                            <!-- Identification Form -->
                            <form action="/rfq/unknown-part/submit" method="POST" enctype="multipart/form-data" class="card border-0 shadow-sm p-4">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                <!-- Section 1: Equipment Context -->
                                <div class="mb-4">
                                    <h2 class="h6 text-primary fw-bold text-uppercase border-bottom pb-2 mb-3">
                                        1. Equipment Context &amp; Application
                                    </h2>
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold">Equipment Make &amp; Model Series</label>
                                            <input type="text" class="form-control" name="equipment_make_model"
                                                   placeholder="e.g. Miura LX-200, Cleaver-Brooks CB-100, Spirax trap station"/>
                                            <small class="text-muted">State the parent machine, boiler, or skid model.</small>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold">Operating Fluid / Medium</label>
                                            <select class="form-select" name="operating_medium">
                                                <option value="">Select fluid...</option>
                                                <option value="saturated_steam">Saturated Steam / Hơi bão hòa</option>
                                                <option value="superheated_steam">Superheated Steam / Hơi quá nhiệt</option>
                                                <option value="condensate">Condensate / Nước ngưng</option>
                                                <option value="feedwater">Boiler Feedwater / Nước cấp lò hơi</option>
                                                <option value="thermal_oil">Thermal Oil / Dầu truyền nhiệt</option>
                                                <option value="compressed_air">Compressed Air / Khí nén</option>
                                                <option value="lpg_gas">Gas / Fuel / LPG</option>
                                                <option value="other">Other Fluid / Môi chất khác</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <!-- Section 2: Operating Parameters -->
                                <div class="mb-4">
                                    <h2 class="h6 text-primary fw-bold text-uppercase border-bottom pb-2 mb-3">
                                        2. Operating Parameters
                                    </h2>
                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <label class="form-label small fw-bold">Operating Pressure (bar)</label>
                                            <input type="number" step="0.1" class="form-control" name="operating_pressure" placeholder="e.g. 10.0"/>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small fw-bold">Operating Temperature (°C)</label>
                                            <input type="number" step="1" class="form-control" name="operating_temperature" placeholder="e.g. 185"/>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small fw-bold">Connection Type &amp; Size</label>
                                            <input type="text" class="form-control" name="connection_type" placeholder="e.g. DN50 Flanged PN40, 1'' NPT"/>
                                        </div>
                                    </div>
                                </div>

                                <!-- Section 3: Nameplate Photo Upload -->
                                <div class="mb-4">
                                    <h2 class="h6 text-primary fw-bold text-uppercase border-bottom pb-2 mb-3">
                                        3. Photo of Nameplate / Equipment Plate
                                    </h2>
                                    <div class="p-3 bg-light border rounded mb-3">
                                        <div class="row align-items-center">
                                            <div class="col-md-7">
                                                <label class="form-label fw-bold mb-1">Upload Stamped Metal Tag or Spec Document</label>
                                                <p class="text-muted small mb-2">
                                                    Attach a clear photo of the stamped tag on the valve body, pump casing, or boiler plate.
                                                </p>
                                                <input type="file" class="form-control" name="nameplate_file" accept="image/*,.pdf"/>
                                                <small class="text-muted">Accepted formats: JPG, PNG, WEBP, PDF (max 10MB).</small>
                                            </div>
                                            <div class="col-md-5 mt-3 mt-md-0 border-start ps-md-4">
                                                <div class="small text-secondary">
                                                    <strong><i class="fa fa-info-circle text-primary me-1"/> Photo Tips:</strong>
                                                    <ul class="ps-3 mb-0 mt-1">
                                                        <li>Clean off oil/dust on the metal plate.</li>
                                                        <li>Ensure model &amp; serial numbers are in focus.</li>
                                                        <li>Include a wider photo showing pipe fitment.</li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Section 4: Contact & Facility Info -->
                                <div class="mb-4">
                                    <h2 class="h6 text-primary fw-bold text-uppercase border-bottom pb-2 mb-3">
                                        4. Contact &amp; Plant Information
                                    </h2>
                                    <div class="row g-3 mb-3">
                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold">Full Name <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" name="contact_name" required="required" placeholder="e.g. Tran Van B"/>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold">Company / Plant Name <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" name="company_name" required="required" placeholder="e.g. Petrovietnam Refinery / Vinamilk"/>
                                        </div>
                                    </div>
                                    <div class="row g-3 mb-3">
                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold">Business Email <span class="text-danger">*</span></label>
                                            <input type="email" class="form-control" name="email" required="required" placeholder="engineer@plant.com"/>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold">Phone Number</label>
                                            <input type="tel" class="form-control" name="phone" placeholder="+84 90 123 4567"/>
                                        </div>
                                    </div>
                                    <div class="row g-3 mb-3">
                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold">Plant / Facility Location</label>
                                            <input type="text" class="form-control" name="project_location" placeholder="e.g. Dung Quat Industrial Zone, Quang Ngai"/>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold">Required Delivery Target</label>
                                            <input type="date" class="form-control" name="required_delivery_date"/>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label small fw-bold">Symptoms / Specific Requirements</label>
                                        <textarea class="form-control" name="notes" rows="3" placeholder="Describe symptoms (e.g. steam leaking through bypass, pump vibration, seal failure, urgency level)..."></textarea>
                                    </div>
                                </div>

                                <!-- Submission Actions -->
                                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                                    <a href="/rfq" class="btn btn-outline-secondary">
                                        <i class="fa fa-arrow-left me-1"/> Back to Standard RFQ
                                    </a>
                                    <button type="submit" class="btn btn-primary btn-lg px-4">
                                        <i class="fa fa-paper-plane me-1"/> Submit for Identification
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
